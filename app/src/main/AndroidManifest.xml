<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- So the Schedules scheduler wakes up at exactly the right minute (turn the filter on/off).
         Since Android 12, exact alarms require this declared permission. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Real Android TV compatibility - without this, the app is invisible in any TV launcher
         (default or third-party), only showing up in Settings > Apps, because the absence of these
         two lines makes Android assume by default that the app REQUIRES a touchscreen and
         leanback=false, and every TV launcher filters by those two flags before deciding what to
         list. Confirmed in the official Android TV guides
         (developer.android.com/training/tv/start/start): the two uses-feature marked "false"
         (touchscreen not required, leanback optional) plus the LEANBACK_LAUNCHER below are exactly
         what TV Bro and other reference FOSS TV apps declare to show up there even though they are,
         at origin, phone apps. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Needed since Android 11 (API 30) package-visibility changes: without this, the App
         Exclusions screen would only ever see a handful of packages, no matter what the user
         types in the search box. We only need launchable apps, not every service/provider on
         the system, so this is the minimal declaration that covers that use case. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".BloodMoonApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.BloodMoon">

        <!-- Required for the dev.rikka.shizuku:api/provider lib to work - confirmed in the official
             Shizuku-API documentation (RikkaApps/Shizuku-API) and in multiple independent sources:
             without this provider, the app can NEVER connect to the Shizuku binder
             (Shizuku.pingBinder() always returns false), even with Shizuku installed and actually
             running - the provider is the real connection mechanism between the app and the Shizuku
             service, not something automatic/optional. This explains exactly the reported bug: "it
             recognizes the app is installed, but gets stuck there" - the next step (checking
             whether it is running) depends entirely on this provider, which never existed here.
             authorities uses applicationId (com.bloodmoon.app), so it becomes
             "com.bloodmoon.app.shizuku" - it must be unique per app installed on the device, which
             is already guaranteed by coming from the applicationId. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />


        <activity
            android:name="com.bloodmoon.app.ui.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:banner="@drawable/tv_banner"
            android:theme="@style/Theme.BloodMoon.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- This line (together with the two uses-feature above) is what makes the TV
                     launcher actually list the app - without it, the app is still technically
                     installable and functional on the TV, but no launcher (neither the default nor
                     third-party) shows it as an option. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Long press on the quick settings tile opens the app -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <service
            android:name="com.bloodmoon.app.service.FilterOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="screen_color_filter_overlay" />
        </service>

        <!-- Minimal accessibility service (does not read the screen): keeps grayscale active on
             Android 16/TV and serves as a last resort to turn the screen off. See the class. -->
        <service
            android:name="com.bloodmoon.app.service.BloodMoonAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name="com.bloodmoon.app.service.BloodMoonTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_moon"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- On/off tile (screen readers announce it as a switch, Android 14+) -->
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <receiver
            android:name="com.bloodmoon.app.receiver.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.bloodmoon.app.receiver.ScheduleAlarmReceiver"
            android:exported="false" />
        <!-- Profile schedules (the app's internal alarm; only the app itself triggers it) -->
        <receiver
            android:name="com.bloodmoon.app.receiver.ProfileScheduleReceiver"
            android:exported="false" />


        <receiver
            android:name="com.bloodmoon.app.receiver.TvAutoOffReceiver"
            android:exported="false" />

        <receiver
            android:name="com.bloodmoon.app.widget.BloodMoonWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/blood_moon_widget_info" />
        </receiver>

    </application>

</manifest>
