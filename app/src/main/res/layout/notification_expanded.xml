<?xml version="1.0" encoding="utf-8"?>
<!-- Expanded notification: state, details, Intensity and Tone bars (each with - and +) and the
     [Pause/Resume] [Turn off] buttons. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/notif_status"
        style="@style/TextAppearance.Compat.Notification.Title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/notif_detail"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_int_label"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="78dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/notif_int_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/notif_progress" />

        <TextView
            android:id="@+id/notif_int_minus"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/notif_btn"
            android:gravity="center"
            android:text="−"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/notif_int_plus"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:background="@drawable/notif_btn"
            android:gravity="center"
            android:text="+"
            android:textSize="18sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_tone_label"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="78dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/notif_tone_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progress="50"
            android:progressDrawable="@drawable/notif_progress" />

        <TextView
            android:id="@+id/notif_tone_minus"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/notif_btn"
            android:gravity="center"
            android:text="−"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/notif_tone_plus"
            style="@style/TextAppearance.Compat.Notification.Title"
            android:layout_width="36dp"
            android:layout_height="30dp"
            android:background="@drawable/notif_btn"
            android:gravity="center"
            android:text="+"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_btn_primary"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn_accent"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notif_btn_stop"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/notif_btn"
            android:gravity="center"
            android:maxLines="1"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
