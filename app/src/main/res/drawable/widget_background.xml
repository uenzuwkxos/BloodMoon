<?xml version="1.0" encoding="utf-8"?>
<!-- Widget background: dark crimson -> near black gradient, large corners and a thin border line. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#2E1217"
        android:endColor="#0F0708"
        android:type="linear" />
    <corners android:radius="26dp" />
    <stroke android:width="1dp" android:color="#3D1F26" />
</shape>
