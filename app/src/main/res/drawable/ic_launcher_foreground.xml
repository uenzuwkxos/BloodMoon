<?xml version="1.0" encoding="utf-8"?>
<!-- Crescent blood moon: one full circle (the moon, red radial gradient) with a second circle
     painted in the exact background color layered on top to "bite" a crescent out of it -
     the standard trick for cut-out shapes in vector icons. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M54,52 m-30,0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="42"
                android:centerY="40"
                android:gradientRadius="46"
                android:startColor="#F0455E"
                android:centerColor="#C41E3A"
                android:endColor="#6E0B1C" />
        </aapt:attr>
    </path>

    <path
        android:pathData="M66,40 m-32,0 a32,32 0 1,0 64,0 a32,32 0 1,0 -64,0"
        android:fillColor="#12080A" />
</vector>
