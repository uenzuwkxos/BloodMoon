<?xml version="1.0" encoding="utf-8"?>
<!-- Splash screen (Android 11 and earlier; on 12+ the system uses the windowSplashScreen*
     attributes from values-v31/themes.xml): pure black background with the centered logo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000" />
        </shape>
    </item>
    <item
        android:width="240dp"
        android:height="240dp"
        android:gravity="center"
        android:drawable="@drawable/ic_splash_art" />
</layer-list>
